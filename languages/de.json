    "manifesto": {
      "title": "🏠 Über AURA",
      "content": "# 🌌 Projekt AURA\n\n**Advanced Unified Reconnaissance Agent**\n\n---\n\n## 👋 Willkommen bei AURA\n\nWenn Sie neu im Bereich Cybersicherheit sind, ist AURA genau richtig für Sie. Es vereint wichtige Sicherheitsfunktionen an einem Ort, um das Lernen und Üben zu erleichtern.\n\n---\n\n## 🧠 Was macht AURA?\n\n* 🔍 Informationen über Netzwerke finden\n* 🧪 Logins und Passwörter testen\n* 🛰️ Offene Ports finden\n* 🔎 OSINT-Suche\n* ⌨️ Eingabeanalyse (kontrolliert)\n* 🔥 Belastungstests\n* 🛡️ Firewall-Bewertung\n\n---\n\n## ⚖️ Verantwortungsvolle Nutzung\n\nNur für eigene Systeme oder Labore. Niemals ohne Erlaubnis nutzen.\n\n---\n\n**Verantwortungsvoll nutzen. Mit Ziel lernen.**"
    },
    "scanner": {
      "title": "🛰️ NETZWERK-SCAN",
      "content": "# 🛰️ Netzwerk-Scanner\n\nAnalysiert einen Host: Ist er online? Welche Ports sind offen? Welche Dienste laufen? Dies ist der erste Schritt jeder Sicherheitsbewertung."
    },
    "ddos": {
      "title": "🔥 DDOS",
      "content": "# 🔥 Belastungstest\n\nSimuliert viele gleichzeitige Zugriffe, um die Stabilität eines Systems zu prüfen und zu sehen, ob die Firewall die Last bewältigen kann."
    },
    "auditoria": {
      "title": "🛡️ SYSTEM-AUDIT",
      "content": "# 🛡️ Sicherheitsprüfung\n\nAnalysiert lokale Berechtigungen, Prozesse und Einstellungen. Hilft dabei, Fehlkonfigurationen auf dem eigenen Rechner zu finden."
    },
    "sherlock": {
      "title": "🔍 SHERLOCK",
      "content": "# 🔍 Digitale Präsenz\n\nSammelt öffentliche Informationen (OSINT). Hilft zu verstehen, wie viel der eigenen Identität im Internet exponiert ist."
    },
    "john": {
      "title": "💀 JOHN THE RIPPER",
      "content": "# 🔐 Passwort-Sicherheitstest\n\nAnalysiert Passwort-Hashes. Wenn ein Passwort schnell geknackt wird, ist es zu schwach. Simuliert Angreifer-Methoden."
    },
    "keylogger": {
      "title": "⌨️ KEYLOGGER",
      "content": "# ⌨️ Eingabe-Überwachung\n\nProtokolliert Tastatureingaben in kontrollierten Umgebungen. Hilft zu verstehen, wie Bedrohungen funktionieren und wie man sich schützt."
    },
    "hydra": {
      "title": "🧰 HYDRA",
      "content": "# 🧰 Login-Sicherheitstest\n\nTestet automatisch Login-Kombinationen, um schwache oder vorhersehbare Passwörter in Diensten wie SSH oder HTTP zu identifizieren."
    }
  }
